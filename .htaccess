DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: redirect bare domain to www
  RewriteCond %{HTTP_HOST} ^solutionseallc\.com$ [NC]
  RewriteRule ^ https://www.solutionseallc.com%{REQUEST_URI} [R=301,L]

  # Clean home URL
  RewriteRule ^index\.html$ / [R=301,L]

  # Legacy /services/ URLs → canonical root pages
  RewriteRule ^services/demolition\.html$ /demolition.html [R=301,L]
  RewriteRule ^services/post-construction-cleaning\.html$ /post-construction-cleaning.html [R=301,L]
  RewriteRule ^services/commercial-industrial-cleanup\.html$ /commercial-industrial-cleanup.html [R=301,L]
  RewriteRule ^services/office-turnover-services\.html$ /office-turnover.html [R=301,L]
  RewriteRule ^services/residential-services\.html$ /residential-post-construction.html [R=301,L]
</IfModule>
